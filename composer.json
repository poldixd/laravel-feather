{
  "name": "poldixd/laravel-feather",
  "keywords": [
    "laravel",
    "feather-icons",
    "feather",
    "blade"
  ],
  "support": {
    "issues": "https://github.com/poldixd/laravel-feather/issues",
    "source": "https://github.com/poldixd/laravel-feather"
  },
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Nils Poltmann",
      "email": "dev@nils.li"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "poldixd\\LaravelFeather\\": "src/LaravelFeather/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "poldixd\\LaravelFeather\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "poldixd\\LaravelFeather\\Providers\\LaravelFeatherServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
